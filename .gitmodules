[submodule "modules/dotbot"]
	path = modules/dotbot
	url = https://github.com/anishathalye/dotbot
[submodule "modules/nvim"]
	path = modules/nvim
	url = https://github.com/VladaTrefil/nvim.git
	branch = main
[submodule "config/zsh/custom/plugins/zsh-autosuggestions"]
	path = config/zsh/custom/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
[submodule "config/zsh/custom/plugins/fast-syntax-highlighting"]
	path = config/zsh/custom/plugins/fast-syntax-highlighting
	url = https://github.com/zdharma-continuum/fast-syntax-highlighting.git
[submodule "config/zsh/custom/themes/powerlevel10k"]
	path = config/zsh/custom/themes/powerlevel10k
	url = https://github.com/romkatv/powerlevel10k.git
[submodule "config/zsh/oh-my-zsh"]
	path = config/zsh/oh-my-zsh
	url = https://github.com/ohmyzsh/ohmyzsh.git
