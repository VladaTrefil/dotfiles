#!/usr/bin/env bash
set -euo pipefail
set +x

usage() {
    printf 'Usage: %s [MANIFEST]\n' "${0##*/}"
    printf 'Default: %s/dotfiles/secrets.tsv\n' "${XDG_CONFIG_HOME:-"$HOME/.config"}"
}

if (($# > 1)); then
    usage >&2
    exit 2
fi

if ! command -v op >/dev/null 2>&1; then
    printf "ERROR: 1Password CLI 'op' is not installed. Run: ./install tools\n" >&2
    exit 2
fi

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
manifest=${1:-"$config_home/dotfiles/secrets.tsv"}
if [[ ! -r $manifest ]]; then
    printf 'ERROR: secrets manifest is not readable: %s\n' "$manifest" >&2
    printf 'Copy config/secrets.tsv.example there and replace its placeholder references.\n' >&2
    exit 2
fi

# Do not inspect or relay op's diagnostics: they can contain account or item
# metadata. This preflight keeps authentication failures separate from a bad
# reference without ever allowing secret output into this process.
if ! op whoami </dev/null >/dev/null 2>&1; then
    printf 'AUTHENTICATION REQUIRED: op is installed, but no authenticated session is available.\n' >&2
    printf 'Run op account add (if needed), then op signin, and retry.\n' >&2
    exit 2
fi

status=0
rows=0
line_number=0
while IFS= read -r line || [[ -n $line ]]; do
    ((line_number += 1))
    [[ -z $line || $line == \#* ]] && continue

    if [[ $line != *$'\t'* ]]; then
        printf 'ERROR: manifest line %d must contain one tab separator.\n' "$line_number" >&2
        exit 2
    fi
    name=${line%%$'\t'*}
    reference=${line#*$'\t'}
    if [[ -z $name || -z $reference || $reference == *$'\t'* ||
          ! $name =~ ^[A-Z_][A-Z0-9_]*$ ||
          ! $reference =~ ^op://[^/]+/[^/]+/.+ ]]; then
        printf 'ERROR: manifest line %d is malformed.\n' "$line_number" >&2
        exit 2
    fi

    ((rows += 1))
    if op read "$reference" </dev/null >/dev/null 2>&1; then
        printf 'OK %s\n' "$name"
    else
        printf 'MISSING %s\n' "$name"
        status=1
    fi
done < "$manifest"

if ((rows == 0)); then
    printf 'ERROR: secrets manifest has no variable rows.\n' >&2
    exit 2
fi

exit "$status"
