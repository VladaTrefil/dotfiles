#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_url=${DOTFILES_ASSETS_REPO_URL:-git@github.com:VladaTrefil/dotfiles-assets.git}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
assets_dir="$data_home/dotfiles-assets"
font_link="$data_home/fonts/dotfiles-assets"
release_font_dir="$data_home/fonts/dotfiles-releases"
wallpaper_link="$HOME/.background"
offline=false

usage() {
    cat <<'HELP'
Usage: bin/fetch-assets [--offline] [--help]

Install the checksum-pinned public Nerd Fonts, optionally clone or fast-forward
the private dotfiles-assets repository, and refresh the per-user font cache.

  --offline  Use verified cached release archives and, when present, an already
             populated private asset directory without contacting the network.
  --help     Show this help.

The public fonts are installed below $XDG_DATA_HOME/fonts/dotfiles-releases (or
$HOME/.local/share/fonts/dotfiles-releases). The optional private checkout is
$XDG_DATA_HOME/dotfiles-assets; paid fonts are linked below the standard user
font directory, and wallpapers are linked as $HOME/.background.

Private assets require SSH access to git@github.com:VladaTrefil/dotfiles-assets.git.
Authentication is deliberately noninteractive: a missing key skips paid assets
with instructions instead of prompting. Public Nerd Fonts still install.
For unusual SSH setups, DOTFILES_ASSETS_SSH_COMMAND may name the ssh command
and options to use. DOTFILES_ASSETS_REPO_URL exists for isolated testing.
HELP
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

for argument in "$@"; do
    case "$argument" in
        --offline) offline=true ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unknown option: $argument (see --help)" ;;
    esac
done

for tool in fc-cache find git ln mkdir python3 readlink timeout; do
    command -v "$tool" >/dev/null 2>&1 || die "Required command is missing: $tool"
done

ssh_command=${DOTFILES_ASSETS_SSH_COMMAND:-ssh}
network_git() {
    local optional=false severity=Error status
    if [[ ${1:-} == --optional ]]; then
        optional=true
        severity=Warning
        shift
    fi
    if timeout --foreground --kill-after=5s 60s \
        env GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false \
        GIT_SSH_COMMAND="$ssh_command -o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o NumberOfPasswordPrompts=0 -o ConnectTimeout=10 -o ConnectionAttempts=1 -o StrictHostKeyChecking=accept-new" \
        git "$@"; then
        return
    else
        status=$?
    fi

    printf '%s\n' \
        "$severity: could not access the private assets repository:" \
        "  $repo_url" \
        'Configure a GitHub SSH key with access to VladaTrefil/dotfiles-assets,' \
        'verify it with "ssh -T git@github.com", and run bin/fetch-assets again.' >&2
    if "$optional"; then
        printf '%s\n' \
            'Continuing without MonoLisa, Font Awesome Pro, or private wallpapers.' >&2
    else
        printf '%s\n' \
            'Use --offline to retain the existing verified private checkout without updating it.' >&2
    fi
    if ((status == 124 || status == 137)); then
        printf '%s\n' 'The noninteractive Git operation timed out after 60 seconds.' >&2
    fi
    return "$status"
}

release_arguments=(--fonts)
if "$offline"; then
    release_arguments+=(--offline)
fi
"$repo_dir/install-releases" "${release_arguments[@]}"

private_available=true
if "$offline"; then
    if [[ ! -d $assets_dir ]]; then
        private_available=false
        printf 'Warning: optional private asset directory is absent: %s\n' "$assets_dir" >&2
    fi
else
    if [[ -e $assets_dir ]]; then
        [[ -d $assets_dir/.git ]] ||
            die "$assets_dir exists but is not a Git checkout; move it aside or use --offline."
        checkout_root=$(git -C "$assets_dir" rev-parse --show-toplevel)
        [[ $(readlink -f -- "$checkout_root") == $(readlink -f -- "$assets_dir") ]] ||
            die "$assets_dir is not the root of its Git checkout."
        [[ $(git -C "$assets_dir" remote get-url origin) == "$repo_url" ]] ||
            die "$assets_dir has an unexpected origin; expected $repo_url."
        branch=$(git -C "$assets_dir" symbolic-ref --quiet --short HEAD) ||
            die "$assets_dir has a detached HEAD; switch it to main before updating."
        [[ $branch == main ]] ||
            die "$assets_dir is on branch '$branch', not main; refusing to move local work."
        [[ -z $(git -C "$assets_dir" status --porcelain --untracked-files=all) ]] ||
            die "$assets_dir has local changes; commit, stash, or remove them before updating."
        network_git -C "$assets_dir" fetch origin refs/heads/main:refs/remotes/origin/main
        git -C "$assets_dir" merge-base --is-ancestor HEAD refs/remotes/origin/main ||
            die "$assets_dir has unpublished or divergent commits; reconcile them manually."
        git -C "$assets_dir" merge --ff-only refs/remotes/origin/main
    else
        mkdir -p -- "$data_home"
        if ! network_git --optional clone --branch main --single-branch -- "$repo_url" "$assets_dir"; then
            private_available=false
        fi
    fi
fi

if "$private_available"; then
    [[ -d $assets_dir/fonts/monolisa ]] || die "Missing asset directory: $assets_dir/fonts/monolisa"
    [[ -d $assets_dir/fonts/fontawesome-pro ]] ||
        die "Missing asset directory: $assets_dir/fonts/fontawesome-pro"
    [[ -d $assets_dir/wallpapers ]] || die "Missing asset directory: $assets_dir/wallpapers"
    [[ -n $(find "$assets_dir/fonts/monolisa" -maxdepth 1 -type f -name '*.ttf' -print -quit) ]] ||
        die 'The MonoLisa asset directory contains no TTF fonts.'
    [[ -n $(find "$assets_dir/fonts/fontawesome-pro" -maxdepth 1 -type f -name '*.ttf' -print -quit) ]] ||
        die 'The Font Awesome Pro asset directory contains no TTF fonts.'
    [[ -n $(find "$assets_dir/wallpapers" -maxdepth 1 -type f \
        \( -name '*.jpg' -o -name '*.jpeg' \) -print -quit) ]] ||
        die 'The wallpaper asset directory contains no JPEG images.'
fi

link_directory() {
    local source=$1 target=$2 actual
    if [[ -L $target ]]; then
        actual=$(readlink -f -- "$target" || true)
        [[ $actual == "$(readlink -f -- "$source")" ]] ||
            die "$target points to '$actual', not '$source'; refusing to replace it."
    elif [[ -e $target ]]; then
        die "$target already exists and is not the managed link; move it aside first."
    else
        ln -s -- "$source" "$target"
        printf 'Linked %s -> %s\n' "$target" "$source"
    fi
}

mkdir -p -- "$data_home/fonts"
fc-cache "$release_font_dir"

if "$private_available"; then
    link_directory "$assets_dir/fonts" "$font_link"
    link_directory "$assets_dir/wallpapers" "$wallpaper_link"
    fc-cache "$font_link"
    printf 'Public fonts and private assets are ready.\n'
else
    printf 'Public fonts are ready; optional private assets were not installed.\n'
fi
