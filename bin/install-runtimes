#!/usr/bin/env python3
"""Provision exactly the home declaration using the Go-asdf command interface."""
import json
import os
from pathlib import Path
import re
import subprocess

root = Path(__file__).resolve().parent.parent
home = Path.home()
config = Path(os.environ.get('XDG_CONFIG_HOME', str(home / '.config')))
data_home = Path(os.environ.get('XDG_DATA_HOME', str(home / '.local/share')))
data = Path(os.environ.get('ASDF_DATA_DIR', str(data_home / 'asdf')))
asdf = str(home / '.local/bin/asdf')
version = subprocess.check_output([asdf, '--version'], text=True).strip()
match = re.search(r'(\d+)\.(\d+)', version)
if not match or tuple(map(int, match.groups())) < (0, 16):
    raise SystemExit(f'Go-asdf >= 0.16 required, found {version}')
manifest = root / 'config/asdf/tool-versions'
if (home / '.tool-versions').resolve() != manifest.resolve():
    raise SystemExit('Run ./install link first: ~/.tool-versions must link to the declaration.')
plugins = json.loads((root / 'provision/plugins.json').read_text())
rows = [line.split() for line in manifest.read_text().splitlines() if line.strip()]
if any(len(row) != 2 or row[0] not in plugins for row in rows):
    raise SystemExit('Expected one explicit version per supported runtime')
# Use the same public paths as Block 1. No shell sourcing or legacy asdf variables.
env = dict(os.environ, ASDF_DATA_DIR=str(data),
           ASDF_CONFIG_FILE=str(config / 'asdf/asdfrc'),
           ASDF_GEM_DEFAULT_PACKAGES_FILE=str(config / 'asdf/default-gems'),
           ASDF_NPM_DEFAULT_PACKAGES_FILE=str(config / 'asdf/default-npm-packages'))
env['PATH'] = f'{home}/.local/bin:{data}/shims:' + env['PATH']
def run(*args):
    subprocess.run(args, env=env, cwd=home, check=True)

for name, runtime in rows:
    spec = plugins[name]
    plugin = data / 'plugins' / name
    if not plugin.exists():
        run(asdf, 'plugin', 'add', name, spec['url'])
    run(asdf, 'plugin', 'update', name, spec['revision'])
    run(asdf, 'install', name, runtime)
    # Reconcile exact package pins on repeat runs too: plugin hooks run only on fresh installs.
    runtime_bin = data / 'installs' / name / runtime / 'bin'
    runtime_env = dict(env, PATH=str(runtime_bin) + ':' + env['PATH'])
    defaults = config / 'asdf' / ('default-gems' if name == 'ruby' else 'default-npm-packages')
    packages = [s.split('#', 1)[0].strip() for s in defaults.read_text().splitlines()]
    packages = [s for s in packages if s]
    command = [str(runtime_bin / 'gem'), 'install', '--no-document'] if name == 'ruby' else [str(runtime_bin / 'npm'), 'install', '--global']
    subprocess.run(command + packages, env=runtime_env, cwd=home, check=True)
    run(asdf, 'reshim', name, runtime)
    print(f'PROVISIONED {name} {runtime}', flush=True)
run(asdf, 'current')
