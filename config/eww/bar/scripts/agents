#!/usr/bin/env python3
"""Count live Codex and Claude sessions that have received a task."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

from websockets.exceptions import WebSocketException
from websockets.sync.client import unix_connect
from websockets.sync.connection import Connection

TIMEOUT = 2


def codex_state(thread: dict[str, Any]) -> str | None:
    """Classify top-level loaded sessions, excluding untouched conversations."""
    if not thread.get("preview", "").strip() or thread.get("parentThreadId"):
        return None
    status = thread.get("status", {})
    if status.get("type") == "idle":
        return "waiting"
    if status.get("type") == "active":
        flags = status.get("activeFlags", [])
        if "waitingOnApproval" in flags or "waitingOnUserInput" in flags:
            return "waiting"
        return "running"
    return None


def has_claude_task(session: dict[str, Any], config_home: Path) -> bool:
    """Distinguish a user task from startup context or an empty prompt."""
    if session.get("kind") == "background" and session.get("state") in {
        "working",
        "done",
    }:
        return True
    session_id = session.get("sessionId", "")
    if not session_id or any(char in session_id for char in "/\\*?[]"):
        return False
    for transcript in (config_home / "projects").glob(f"*/{session_id}.jsonl"):
        try:
            with transcript.open(encoding="utf-8") as stream:
                for line in stream:
                    try:
                        entry = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if entry.get("type") != "user" or entry.get("isMeta"):
                        continue
                    content = entry.get("message", {}).get("content", "")
                    if isinstance(content, str) and content.strip():
                        return True
                    if isinstance(content, list) and any(
                        block.get("type") == "text" and block.get("text", "").strip()
                        for block in content
                        if isinstance(block, dict)
                    ):
                        return True
        except OSError:
            continue
    return False


def claude_state(session: dict[str, Any], config_home: Path) -> str | None:
    """Use background task state or an interactive session's live process state."""
    state = session.get("state")
    if state in {"failed", "stopped"} or not has_claude_task(session, config_home):
        return None
    if state == "working":
        return "running"
    if state in {"blocked", "done"}:
        return "waiting"
    status = session.get("status")
    if status == "busy":
        return "running"
    if status in {"waiting", "idle"}:
        return "waiting"
    return None


def rpc(
    connection: Connection, request_id: int, method: str, params: dict[str, Any]
) -> dict[str, Any]:
    """Read the matching response without confusing notifications for replies."""
    connection.send(json.dumps({"id": request_id, "method": method, "params": params}))
    deadline = time.monotonic() + TIMEOUT
    while True:
        message = json.loads(
            connection.recv(timeout=max(0, deadline - time.monotonic()))
        )
        if message.get("id") == request_id:
            if "error" in message:
                raise RuntimeError(
                    message["error"].get("message", "Codex request failed")
                )
            return message["result"]


def codex_threads(config_home: Path) -> list[dict[str, Any]]:
    """Query the existing daemon without loading, resuming, or starting threads."""
    socket_path = config_home / "app-server-control/app-server-control.sock"
    threads = []
    with unix_connect(
        str(socket_path), open_timeout=TIMEOUT, close_timeout=0.2
    ) as connection:
        rpc(
            connection,
            0,
            "initialize",
            {
                "clientInfo": {"name": "eww-agent-counts", "version": "1"},
            },
        )
        connection.send(json.dumps({"method": "initialized"}))
        request_id = 1
        cursor = None
        while True:
            loaded = rpc(
                connection, request_id, "thread/loaded/list", {"cursor": cursor}
            )
            for thread_id in loaded["data"]:
                request_id += 1
                try:
                    result = rpc(
                        connection,
                        request_id,
                        "thread/read",
                        {
                            "threadId": thread_id,
                            "includeTurns": False,
                        },
                    )
                except RuntimeError:
                    # A session can close between listing it and reading its status.
                    continue
                threads.append(result["thread"])
            cursor = loaded.get("nextCursor")
            if not cursor:
                return threads
            request_id += 1


def claude_sessions() -> list[dict[str, Any]]:
    """Read live sessions; omit historical completed background tasks."""
    result = subprocess.run(
        ["claude", "agents", "--json"],
        check=True,
        capture_output=True,
        text=True,
        timeout=TIMEOUT,
    )
    return json.loads(result.stdout)


def collect_counts() -> dict[str, int]:
    """Keep each provider independent when its CLI or daemon is unavailable."""
    counts = {"running": 0, "waiting": 0}
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    claude_home = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    for provider, read_sessions, classify in (
        ("Codex", lambda: codex_threads(codex_home), codex_state),
        ("Claude", claude_sessions, lambda session: claude_state(session, claude_home)),
    ):
        try:
            for session in read_sessions():
                state = classify(session)
                if state:
                    counts[state] += 1
        except FileNotFoundError:
            # Both CLIs are optional; never start a daemon just to populate the bar.
            continue
        except (
            OSError,
            RuntimeError,
            ValueError,
            KeyError,
            subprocess.SubprocessError,
            WebSocketException,
        ) as error:
            print(f"agents: {provider} status unavailable: {error}", file=sys.stderr)
    return counts


if __name__ == "__main__":
    print(json.dumps(collect_counts(), separators=(",", ":")))
