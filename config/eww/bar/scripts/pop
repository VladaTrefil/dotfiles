#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    calendar|system|bluetooth) ;;
    *) printf 'Usage: %s {calendar|system|bluetooth} MONITOR\n' "$0" >&2; exit 2 ;;
esac
[[ -n ${2:-} ]] || { printf 'Usage: %s {calendar|system|bluetooth} MONITOR\n' "$0" >&2; exit 2; }
window=$1
monitor=$2
[[ $window == bluetooth ]] && window=bluetooth_menu
active_windows=$(eww active-windows)

if grep -q "^${window}:" <<< "$active_windows"; then
    eww close "$window"
else
    for other in calendar system bluetooth_menu; do
        if grep -q "^${other}:" <<< "$active_windows"; then
            eww close "$other"
        fi
    done
    eww open --arg "monitor=$monitor" "$window"
fi
