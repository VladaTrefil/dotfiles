[user]
	email = vladislav.trefil@protonmail.com
	name = Vlada
[core]
	editor = nvim
[alias]
	br = branch -vv
	bra = branch -vv --all
	bed = branch --edit-description
	aa = add .
	ci = commit -v
	ca = commit --amend -v
	s = status
	save = commit -a -m "Save"
	co = checkout
	pullrb = pull --rebase
	lg = log -p
	gr = log --graph --format=oneline # graph
	grd = log --graph --format=fuller # graph detail
	gra = log --graph --format=oneline --all # graph all
	grad = log --graph --format=fuller --all # graph all in detail
	update-submodules = submodule update --init --recursive
	upgrade-submodules = submodule update --init --remote

[push]
	default = upstream

[url "git@github.com:VladaTrefil/nvim.git"]
	pushInsteadOf = https://github.com/VladaTrefil/nvim.git

[credential]
	helper = cache --timeout=3600

[grep]
	lineNumber = true

[init]
	defaultBranch = main
[pull]
	rebase = true
