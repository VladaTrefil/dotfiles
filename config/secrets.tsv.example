# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/secrets.tsv.
# Replace every placeholder with the matching personal 1Password reference.
OPENAI_API_KEY	op://Vault/Item/openai-api-key
ANTHROPIC_API_KEY	op://Vault/Item/anthropic-api-key
GITHUB_USERNAME	op://Vault/Item/github-username
GITHUB_PASSWORD	op://Vault/Item/github-token
GITHUB_KEY_NAME	op://Vault/Item/github-key-name
