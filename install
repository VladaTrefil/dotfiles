#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
dry_run=false

usage() {
    cat <<'EOF'
Usage: ./install [link|packages|tools|runtimes|system|all] [options]

  link        Initialize pinned submodules and create links (default).
  packages    Enable approved repositories and install RPM/Flatpak manifests as root.
  tools       Install checksum-pinned release tools, including the QMK wheel set.
  runtimes    Provision tool-versions and its npm/gem defaults with Go-asdf.
  system      Configure user state; use --root --user NAME for privileged state.
  all         Run packages, link, tools, runtimes, system, then show docs/manual-steps.md.

Options for packages and all:
  --group base,dev    Read only the named packages/<group>.txt files.
  --dry-run           Preview without installing packages or changing links.
  -h, --help          Show help (also accepted by every subcommand).

No command invokes sudo. Run a printed package command as root when needed.
EOF
}

die() {
    printf 'Error: %s\n' "$*" >&2
    usage >&2
    exit 2
}

print_command() {
    printf '%q' "$1"
    shift
    printf ' %q' "$@"
    printf '\n'
}

install_packages() {
    local groups='' group file line answer release_output fedora_release rpmfusion_url repo_id
    local apps_selected=false desktop_selected=false flatpak_selected=false copr_selected=false
    local rpmfusion_pending=false flathub_pending=false ffmpeg_swap=false
    local -a files=() names=() packages=() flatpaks=() coprs=() command=() rpm_groups=() release_args=()
    local -a pinned_rpms=() pending_coprs=()
    local -A seen=()
    while (($#)); do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --group)
                (($# >= 2)) || die '--group requires a comma-separated list'
                [[ $2 =~ ^[a-zA-Z0-9_-]+(,[a-zA-Z0-9_-]+)*$ ]] || die 'Invalid group list'
                groups=$2
                shift 2
                ;;
            *) die "Unknown package option: $1" ;;
        esac
    done

    if [[ -n $groups ]]; then
        IFS=',' read -r -a names <<< "$groups"
        for group in "${names[@]}"; do
            file="$repo_dir/packages/$group.txt"
            [[ -f $file ]] || die "Unknown package group: $group"
            files+=("$file")
        done
    else
        shopt -s nullglob
        files=("$repo_dir"/packages/*.txt)
        shopt -u nullglob
    fi

    for file in "${files[@]}"; do
        case "${file##*/}" in
            apps.txt) apps_selected=true; rpm_groups+=(apps) ;;
            desktop.txt) desktop_selected=true; rpm_groups+=(desktop) ;;
            flatpak.txt) flatpak_selected=true; continue ;;
            copr.txt) copr_selected=true; continue ;;
        esac
        while IFS= read -r line || [[ -n $line ]]; do
            line=${line%%#*}
            # Trim whitespace without word splitting or command evaluation.
            line=${line#"${line%%[![:space:]]*}"}
            line=${line%"${line##*[![:space:]]}"}
            [[ -n $line ]] || continue
            [[ $line =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || die "Invalid package name in $file: $line"
            if [[ ! ${seen[$line]+present} ]]; then
                packages+=("$line")
                seen[$line]=1
            fi
        done < "$file"
    done

    # A standalone special group remains usable on a minimal Fedora install.
    if "$flatpak_selected" && [[ ! ${seen[flatpak]+present} ]]; then
        packages+=(flatpak)
        seen[flatpak]=1
    fi
    if "$copr_selected" && [[ ! ${seen[dnf5-plugins]+present} ]]; then
        packages+=(dnf5-plugins)
        seen[dnf5-plugins]=1
    fi

    if "$flatpak_selected"; then
        while IFS= read -r line || [[ -n $line ]]; do
            line=${line%%#*}
            line=${line#"${line%%[![:space:]]*}"}
            line=${line%"${line##*[![:space:]]}"}
            [[ -n $line ]] || continue
            [[ $line =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]+$ ]] || die "Invalid Flatpak ID: $line"
            flatpaks+=("$line")
        done < "$repo_dir/packages/flatpak.txt"
    fi
    # The Sway package itself depends on this source, so selecting desktop also
    # selects the reviewed COPR even when --group omits the bookkeeping file.
    if "$desktop_selected"; then copr_selected=true; fi
    if "$copr_selected"; then
        if [[ ! ${seen[dnf5-plugins]+present} ]]; then
            packages+=(dnf5-plugins)
            seen[dnf5-plugins]=1
        fi
        while IFS= read -r line || [[ -n $line ]]; do
            line=${line%%#*}
            line=${line#"${line%%[![:space:]]*}"}
            line=${line%"${line##*[![:space:]]}"}
            [[ -n $line ]] || continue
            [[ $line =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]] || die "Invalid COPR name: $line"
            coprs+=("$line")
        done < "$repo_dir/packages/copr.txt"
    fi

    if ((${#packages[@]} == 0 && ${#flatpaks[@]} == 0 && ${#coprs[@]} == 0)); then
        printf 'No packages selected; nothing to run.\n'
        return
    fi

    if ((${#rpm_groups[@]})); then
        release_args=(--rpm)
        for group in "${rpm_groups[@]}"; do release_args+=(--group "$group"); done
        if "$dry_run"; then
            printf 'Selected groups include checksum-pinned RPMs from provision/releases.json.\n'
        elif ((EUID == 0)); then
            release_output=$("$repo_dir/bin/install-releases" "${release_args[@]}")
            while IFS= read -r line; do
                [[ -n $line ]] && pinned_rpms+=("$line")
            done <<< "$release_output"
            packages+=("${pinned_rpms[@]}")
            printf 'Verified pinned RPMs before dnf; recorded SHA-256 values are the integrity controls.\n'
        fi
    fi

    if "$dry_run" || ((EUID != 0)); then
        pending_coprs=("${coprs[@]}")
        "$apps_selected" && rpmfusion_pending=true
        "$flatpak_selected" && flathub_pending=true
    else
        for line in "${coprs[@]}"; do
            repo_id="copr:copr.fedorainfracloud.org:${line//\//:}"
            if dnf repolist --enabled 2>/dev/null | awk -v expected="$repo_id" '$1 == expected { found = 1 } END { exit !found }'; then
                printf 'Already enabled: COPR %s\n' "$line"
            else
                pending_coprs+=("$line")
            fi
        done
        if "$apps_selected"; then
            if rpm -q rpmfusion-free-release >/dev/null 2>&1; then
                printf 'Already enabled: RPM Fusion free\n'
            else
                rpmfusion_pending=true
            fi
        fi
        if "$flatpak_selected" && command -v flatpak >/dev/null 2>&1 &&
            flatpak remotes --system --columns=name 2>/dev/null | grep -Fxq flathub; then
            printf 'Already enabled: system Flathub remote\n'
        elif "$flatpak_selected"; then
            flathub_pending=true
        fi
        if "$apps_selected" && rpm -q ffmpeg-free >/dev/null 2>&1 && ! rpm -q ffmpeg >/dev/null 2>&1; then
            ffmpeg_swap=true
        fi
    fi

    printf 'Package phase plan:\n'
    for line in "${pending_coprs[@]}"; do
        print_command dnf copr enable -y "$line"
    done
    if "$rpmfusion_pending"; then
        if "$dry_run" || ((EUID != 0)); then
            rpmfusion_url='https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-<FEDORA_RELEASE>.noarch.rpm'
        else
            fedora_release=$(rpm -E %fedora)
            [[ $fedora_release =~ ^[0-9]+$ ]] || die "Invalid Fedora release: $fedora_release"
            rpmfusion_url="https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$fedora_release.noarch.rpm"
        fi
        print_command dnf install -y -- "$rpmfusion_url"
    fi
    if "$ffmpeg_swap"; then
        print_command dnf swap -y --allowerasing ffmpeg-free ffmpeg
    elif "$dry_run" && "$apps_selected"; then
        printf 'If ffmpeg-free is installed, dnf swap -y --allowerasing ffmpeg-free ffmpeg\n'
    fi
    if ((${#packages[@]})); then
        command=(dnf install -y -- "${packages[@]}")
        if "$dry_run" && ((${#rpm_groups[@]})); then
            command+=('<verified-pinned-RPMs-for-selected-groups>')
        fi
        print_command "${command[@]}"
    fi
    if "$flathub_pending"; then
        print_command flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    fi
    if ((${#flatpaks[@]})); then
        print_command flatpak install --system -y flathub "${flatpaks[@]}"
    fi
    if "$dry_run"; then return; fi
    if ((EUID != 0)); then
        printf 'Root is required. Run this packages phase as root.\n' >&2
        return 1
    fi
    printf 'Run every action printed above? Type yes: '
    if ! IFS= read -r answer || [[ $answer != yes ]]; then
        printf 'Cancelled.\n' >&2
        return 1
    fi
    for line in "${pending_coprs[@]}"; do dnf copr enable -y "$line"; done
    if "$rpmfusion_pending"; then dnf install -y -- "$rpmfusion_url"; fi
    if "$ffmpeg_swap"; then dnf swap -y --allowerasing ffmpeg-free ffmpeg; fi
    if ((${#packages[@]})); then "${command[@]}"; fi
    if "$flathub_pending"; then
        flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    fi
    if ((${#flatpaks[@]})); then flatpak install --system -y flathub "${flatpaks[@]}"; fi
}

install_link() {
    # New cache parents must also pass Zsh's completion ownership/mode checks.
    umask 077
    # Dotbot expands environment variables, but not shell default expressions.
    export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
    export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
    export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
    export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
    if [[ -e $XDG_CONFIG_HOME/bundle && ! -d $XDG_CONFIG_HOME/bundle ]]; then
        printf 'Error: %s/bundle is a file; migrate its settings to bundle/config separately before linking.\n' "$XDG_CONFIG_HOME" >&2
        return 1
    fi
    git -C "$repo_dir" submodule update --init --recursive
    # This pinned p10k compiles beside its sources. Give it a runtime copy in
    # cache so interactive startup never writes into the submodule checkout.
    local theme_source theme_revision theme_cache staging
    theme_source="$repo_dir/config/zsh/custom/themes/powerlevel10k"
    theme_revision=$(git -C "$theme_source" rev-parse HEAD)
    theme_cache="$XDG_CACHE_HOME/zsh/powerlevel10k-$theme_revision"
    if [[ ! -d $theme_cache ]]; then
        mkdir -p -- "$XDG_CACHE_HOME/zsh"
        staging=$(mktemp -d "$XDG_CACHE_HOME/zsh/.powerlevel10k.XXXXXX")
        if git -C "$theme_source" archive HEAD | tar -xf - -C "$staging"; then
            mv -- "$staging" "$theme_cache"
        else
            rm -rf -- "$staging"
            return 1
        fi
    fi
    # Fetch the checksum-pinned daemon during installation, so the first real
    # prompt does not download binaries or print gitstatus bootstrap messages.
    sh "$theme_cache/gitstatus/install"
    PYTHONDONTWRITEBYTECODE=1 "$repo_dir/modules/dotbot/bin/dotbot" \
        --base-directory "$repo_dir" --config-file "$repo_dir/install.conf.yaml" \
        --no-color --verbose
    "$repo_dir/bin/configure-tools"
}

install_system() {
    "$repo_dir/bin/system-setup" "$@"
}

subcommand=${1:-link}
if (($#)); then shift; fi
case "$subcommand" in
    -h|--help) usage; exit 0 ;;
    link|packages|tools|runtimes|system|all) ;;
    *) die "Unknown subcommand: $subcommand" ;;
esac
if [[ $subcommand != system ]]; then
    for argument in "$@"; do
        case "$argument" in -h|--help) usage; exit 0 ;; esac
    done
fi

case "$subcommand" in
    link)
        (($# == 0)) || die 'link accepts only --help'
        install_link
        ;;
    packages) install_packages "$@" ;;
    tools|runtimes)
        (($# == 0)) || die "$subcommand accepts only --help"
        if [[ $subcommand == tools ]]; then
            "$repo_dir/bin/install-releases"
        else
            "$repo_dir/bin/install-runtimes"
        fi
        ;;
    system)
        install_system "$@"
        ;;
    all)
        install_packages "$@"
        if "$dry_run"; then
            printf 'Would run link, tools, runtimes, then system (stub), then show manual steps.\n'
        else
            install_link
            "$repo_dir/bin/install-releases"
            "$repo_dir/bin/install-runtimes"
            install_system
        fi
        cat -- "$repo_dir/docs/manual-steps.md"
        ;;
esac
